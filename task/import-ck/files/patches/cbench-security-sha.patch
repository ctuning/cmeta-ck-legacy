# sha.h: the 32-bit words of the digest as unsigned int (unsigned long is 64 bits on Linux, macOS and
#   Android, where the digest was wrong and changed with the compiler), and LITTLE_ENDIAN where the
#   system headers do not define it (Windows): every target is little-endian; the digest is now
#   the SHA-0 of the file on every target (SHA-1 with -DUSE_MODIFIED_SHA)
# sha.c: the digest printed as unsigned long, as its format says
--- a/sha.h
+++ b/sha.h
@@ -7,7 +7,12 @@
 /* Useful defines & typedefs */
 
 typedef unsigned char BYTE;
-typedef unsigned long LONG;
+typedef unsigned int LONG;	/* cMeta: 32 bits on every target (was unsigned long) */
+
+/* cMeta: every target of today is little-endian (x86-64, arm64); Windows has no LITTLE_ENDIAN */
+#ifndef LITTLE_ENDIAN
+#define LITTLE_ENDIAN
+#endif
 
 #define SHA_BLOCKSIZE		64
 #define SHA_DIGESTSIZE		20
--- a/sha.c
+++ b/sha.c
@@ -205,7 +205,7 @@
 void sha_print(SHA_INFO *sha_info)
 {
     printf("%08lx %08lx %08lx %08lx %08lx\n",
-	sha_info->digest[0], sha_info->digest[1], sha_info->digest[2],
-	sha_info->digest[3], sha_info->digest[4]);
-}
-
+	(unsigned long) sha_info->digest[0], (unsigned long) sha_info->digest[1], (unsigned long) sha_info->digest[2],
+	(unsigned long) sha_info->digest[3], (unsigned long) sha_info->digest[4]);
+}
+
