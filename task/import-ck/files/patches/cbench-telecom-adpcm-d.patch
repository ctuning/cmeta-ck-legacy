# rawdaudio.c: reads and writes the files given on its command line (else the standard streams, as before),
#   in binary mode, with fread/fwrite instead of read(0)/write(1) (no <unistd.h>; an iOS app has no
#   redirection, Windows reads the standard streams in text mode)
--- a/rawdaudio.c
+++ b/rawdaudio.c
@@ -15,16 +15,29 @@
 char	abuf[NSAMPLES/2];
 short	sbuf[NSAMPLES];
 
-int main()
+int main(int argc, char *argv[])
 {
     long ct_repeat=0;
     long ct_repeat_max=1;
     int ct_return=0;
     int n;
+    /* cMeta: the input and output files may be given on the command line (an iOS app has no
+       redirection, and Windows reads and writes the standard streams in text mode) */
+    FILE *ck_in = stdin;
+    FILE *ck_out = stdout;
 
 #ifdef XOPENME
   xopenme_init(1,0);
 #endif
+
+    if (argc > 1 && (ck_in = fopen(argv[1], "rb")) == NULL) {
+	perror(argv[1]);
+	exit(1);
+    }
+    if (argc > 2 && (ck_out = fopen(argv[2], "wb")) == NULL) {
+	perror(argv[2]);
+	exit(1);
+    }
 
     if (getenv("CT_REPEAT_MAIN")!=NULL) ct_repeat_max=atol(getenv("CT_REPEAT_MAIN"));
 
@@ -35,8 +48,8 @@
     while(1) {
         struct adpcm_state current_state = state;
 
-	n = read(0, abuf, NSAMPLES/2);
-	if ( n < 0 ) {
+	n = fread(abuf, 1, NSAMPLES/2, ck_in);
+	if ( ferror(ck_in) ) {
 	    perror("input file");
 	    exit(1);
 	}
@@ -53,7 +66,7 @@
   	  adpcm_decoder(abuf, sbuf, n*2, &state);  /* modifies state */
 	}
 
-	write(1, sbuf, n*4);
+	fwrite(sbuf, 1, n*4, ck_out);
     }
 
 #ifdef XOPENME
@@ -63,6 +76,9 @@
   xopenme_finish();
 #endif
 
+    if (ck_out != stdout)
+	fclose(ck_out);
+
     return 0;
 }
 
